# =============================================================================
# COMMON GROUND — Café E-Commerce & Order Management Platform (.env.example)
# Copy to .env and fill in production credentials. Never commit .env to Git.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=8090
CORS_ORIGIN=http://localhost:8090

# Database Configuration
# When DATABASE_URL is set, the server connects to external/managed PostgreSQL via node-postgres (pg).
# When DATABASE_URL is omitted in local development/test, the server boots an embedded persistent
# PostgreSQL 16 instance (@electric-sql/pglite) stored in ./.pgdata
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/common_ground_cafe
PGLITE_DATA_DIR=./.pgdata

# Security & Authentication
AUTH_TOKEN_SECRET=replace-with-64-byte-hex-secret-in-production
TOKEN_EXPIRY_HOURS=24

# Default Staff & Admin Seed Accounts (for initial bootstrap only; change passwords immediately)
ADMIN_SEED_EMAIL=sam.rivera@commonground.coffee
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASS
BARISTA_SEED_EMAIL=jamie@commonground.coffee
BARISTA_SEED_PASSWORD=CHANGE_ME_BARISTA_PASS

# Business & Localization Settings
CAFE_CURRENCY=EGP
CAFE_DELIVERY_FEE_EGP=25.00
CAFE_TAX_RATE=0.00

# Telegram Notification Bot (Optional — order creation succeeds even if unset or unreachable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
